# Local development defaults to file storage in ./data — no database needed.
# To run against Azure SQL locally, set these (managed identity falls back to `az login`):
# SQL_SERVER=metricus.database.windows.net
# SQL_DATABASE=frenchst
# SQL_AUTH=managed-identity        # or: sql
# SQL_USER=...
# SQL_PASSWORD=...
# SQL_CONNECTION_STRING=...        # overrides the above if set
# SQL_MI_CLIENT_ID=...             # only for a user-assigned managed identity
# STORAGE=file                     # force local file storage
# DATA_DIR=./data
# PORT=8080
